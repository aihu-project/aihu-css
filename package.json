{
  "name": "@aihu/css-engine",
  "version": "0.6.2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "import": "./dist/packs.js",
      "default": "./dist/packs.js"
    },
    "./styles/aihu-default.css": "./styles/aihu-default.css",
    "./styles/aihu-graphite.css": "./styles/aihu-graphite.css",
    "./styles/*": "./styles/*",
    "./runtime/cn": {
      "types": "./dist/runtime/cn.d.ts",
      "import": "./dist/runtime/cn.js"
    },
    "./runtime/progressive": {
      "types": "./dist/runtime/progressive.d.ts",
      "import": "./dist/runtime/progressive.js"
    }
  },
  "files": [
    "dist",
    "crates",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@aihu/arbor": "^4.1.2",
    "@aihu/compiler": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "bun-types": "latest",
    "@types/node": "^20.16.5",
    "jsdom": "^25.0.1",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@aihu/css-engine-darwin-arm64": "0.1.17",
    "@aihu/css-engine-darwin-x64": "0.1.17",
    "@aihu/css-engine-linux-x64-gnu": "0.1.17",
    "@aihu/css-engine-win32-x64-msvc": "0.1.17"
  },
  "scripts": {
    "build": "bun run build:rust && bun run gen:cn-map && bun run gen:style-packs && rolldown -c",
    "build:rust": "cargo build --release",
    "gen:cn-map": "bun scripts/gen-cn-conflict-map.ts",
    "gen:style-packs": "bun scripts/gen-style-packs.ts",
    "gen:animations-gallery": "bun scripts/gen-animations-gallery.ts",
    "test": "vitest run",
    "check:cn-map": "bun scripts/gen-cn-conflict-map.ts --check",
    "check:animations-gallery": "bun scripts/gen-animations-gallery.ts --check",
    "check:platform-pins": "bun scripts/check-platform-pins.ts",
    "test:rust": "cargo test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:lint": "biome ci .",
    "check:ci": "bun run check:lint && bun run typecheck && bun run check:platform-pins && bun run test && bun run test:rust && bun run build && bun run check:animations-gallery && bun pm pack --dry-run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "prepublishOnly": "bun run build"
  },
  "description": "aihu CSS engine \u2014 Tailwind v4 hard fork with WC-native scoped output.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-css.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-css#readme",
  "bugs": "https://github.com/aihu-project/aihu-css/issues",
  "publishConfig": {
    "access": "public"
  }
}
